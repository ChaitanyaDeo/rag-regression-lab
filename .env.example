OLLAMA_HOST=http://localhost:11434
LOG_LEVEL=INFO

# --- Judge endpoint (optional) ---------------------------------------------
# The judge model and provider come from the run config (judge_model, judge_provider).
# These variables only say WHERE the judge runs. Never hashed, stored or logged.
#
# Default (judge_provider: ollama): nothing to set; the judge uses OLLAMA_HOST.
#
# judge_provider: openai, or any OpenAI-compatible server (vLLM, LM Studio, OpenRouter, ...):
# JUDGE_BASE_URL=https://example.com/v1
# JUDGE_API_KEY=<your-key>
#
# Fallbacks when the JUDGE_* variables are unset (openai provider only):
# OPENAI_BASE_URL=https://example.com/v1
# OPENAI_API_KEY=<your-key>
